<?xml version="1.0" encoding="utf-8"?>
<!-- 车机设置行透出窗口统一模糊的壁纸，手机清单继续使用原样式 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/glass_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/car_control_surface" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/glass_subtle_border" />
        </shape>
    </item>
</ripple>
