<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/glass_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><solid android:color="@color/glass_muted_panel" /><corners android:radius="12dp" /></shape>
            </item>
            <item android:state_selected="true">
                <shape><solid android:color="@color/glass_selected" /><stroke android:width="1dp" android:color="@color/m3_primary" /><corners android:radius="12dp" /></shape>
            </item>
            <item>
                <shape><solid android:color="@color/car_control_surface" /><stroke android:width="1dp" android:color="@color/glass_subtle_border" /><corners android:radius="12dp" /></shape>
            </item>
        </selector>
    </item>
    <item android:id="@android:id/mask">
        <shape><solid android:color="#FFFFFF" /><corners android:radius="12dp" /></shape>
    </item>
</ripple>
