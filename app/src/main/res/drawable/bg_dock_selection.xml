<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_selected" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/m3_primary" android:dashWidth="3dp" android:dashGap="2dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/glass_selected" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="@color/m3_primary" />
                </shape>
            </item>
            <item android:width="12dp" android:height="3dp" android:gravity="bottom|center_horizontal" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/m3_primary" />
                    <corners android:radius="2dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
