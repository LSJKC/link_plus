<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PhonePanelBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">28dp</item>
    </style>
    <style name="PhonePanelCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_phone_card</item>
        <item name="android:clipToOutline">true</item>
        <item name="android:padding">18dp</item>
    </style>
    <style name="PhoneInlineNotice">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAlignment">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/m3_primary</item>
        <item name="android:background">@drawable/bg_phone_notice</item>
    </style>
    <style name="PhonePanelTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:accessibilityHeading">true</item>
    </style>
    <style name="PhonePanelCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/m3_on_var</item>
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="PhonePanelValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/m3_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:layout_marginStart">12dp</item>
    </style>
    <style name="PhonePanelDisclosure">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="PhonePanelArrow">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:src">@drawable/ic_chev_down</item>
        <item name="android:tint">@color/m3_on_var</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="PhonePanelSlider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:splitTrack">false</item>
        <item name="android:progressTint">@color/m3_primary</item>
        <item name="android:thumbTint">@color/m3_primary</item>
    </style>
    <style name="PhonePanelSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/phone_option_text</item>
        <item name="android:background">@drawable/bg_phone_option</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- 状态标签只表达状态，不承担点击操作，保留随字体放大的高度 -->
    <style name="PhoneStatusBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">28dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">13sp</item>
        <item name="android:background">@drawable/bg_badge_todo</item>
        <item name="android:textColor">@color/phone_badge_warning_text</item>
    </style>
    <!-- 使用显式背景与状态色，避免系统默认按钮的灰色阴影和内缩 -->
    <style name="PhoneAction" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:background">@drawable/bg_phone_connect</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/phone_action_primary_text</item>
    </style>
    <style name="PhoneAction.Secondary" parent="PhoneAction">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/bg_phone_action_secondary</item>
        <item name="android:textColor">@color/phone_action_secondary_text</item>
    </style>
</resources>
