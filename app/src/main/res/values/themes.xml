<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 自有窗口保持不透明，背景由应用绘制，避免透出手机系统壁纸 -->
    <style name="Theme.CarPlaySender" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/m3_surface</item>
        <item name="android:statusBarColor">@color/m3_surface</item>
        <item name="android:navigationBarColor">@color/m3_surface</item>
        <item name="android:colorBackground">@color/m3_surface</item>
        <item name="android:textColorPrimary">@color/m3_on_surface</item>
        <item name="android:textColorSecondary">@color/m3_on_var</item>
        <item name="colorAccent">@color/m3_primary</item>
        <item name="colorControlNormal">@color/m3_outline</item>
        <item name="colorControlActivated">@color/m3_primary</item>
        <item name="android:windowLightStatusBar">@bool/glass_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/glass_light_system_bars</item>
    </style>

    <style name="Theme.CarPlaySender.Launcher" parent="Theme.CarPlaySender">
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <style name="Theme.CarPlaySender.Settings" parent="Theme.CarPlaySender.Launcher">
        <item name="android:windowAnimationStyle">@style/CarPlaySettingsAnimation</item>
    </style>

    <style name="CarPlaySettingsAnimation" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/settings_in</item>
        <item name="android:activityOpenExitAnimation">@anim/stay</item>
        <item name="android:activityCloseEnterAnimation">@anim/stay</item>
        <item name="android:activityCloseExitAnimation">@anim/settings_out</item>
    </style>
</resources>