<?xml version="1.0" encoding="utf-8"?>
<!-- 手机设置内容页，使用独立排版和共享参数绑定 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 返回按钮拥有独立点击与无障碍语义，标题不能与按钮合并 -->
<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp" tools:ignore="UseCompoundDrawables">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_ripple_circle"
            android:contentDescription="@string/ui_text_572cf45ba436"
            android:padding="13dp"
            android:src="@drawable/ic_chev_left" />

        <TextView
            android:id="@+id/contentTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/m3_on_surface"
            android:textSize="21sp"
            android:fontFamily="sans-serif-medium"
            android:accessibilityHeading="true" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
