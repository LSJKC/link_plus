<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/phoneConnectionContent"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout style="@style/PhonePanelCard">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/PhonePanelCaption" android:layout_width="0dp"
                android:layout_weight="1" android:text="@string/phone_connection_vehicle" />
            <TextView android:id="@+id/btBadge" style="@style/PhoneStatusBadge" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="42dp" android:layout_height="42dp"
                android:padding="10dp" android:background="@drawable/bg_phone_nav_active"
                android:src="@drawable/ic_car" app:tint="@color/m3_primary" android:contentDescription="@null" />
            <TextView android:id="@+id/phoneConnectionVehicle" style="@style/PhonePanelTitle"
                android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp" android:text="@string/phone_connection_choose_vehicle" />
            <TextView android:id="@+id/btnPickTarget" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:minWidth="48dp" android:minHeight="48dp"
                android:gravity="center" android:paddingHorizontal="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="@string/phone_connection_change" android:textSize="13sp"
                android:textColor="@color/m3_primary" android:clickable="true" android:focusable="true" />
        </LinearLayout>
        <TextView android:id="@+id/btDesc" style="@style/PhonePanelCaption" android:layout_marginTop="12dp" />
    </LinearLayout>

    <LinearLayout style="@style/PhonePanelCard">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView style="@style/PhonePanelTitle" android:layout_width="0dp"
                android:layout_weight="1" android:text="@string/phone_connection_wireless" />
            <TextView android:id="@+id/phoneWifiState" style="@style/PhonePanelCaption"
                android:layout_width="wrap_content" android:layout_marginStart="12dp"
                android:text="@string/phone_connection_waiting" android:textColor="@color/m3_primary" />
        </LinearLayout>
        <TextView style="@style/PhonePanelCaption" android:layout_marginTop="8dp"
            android:text="@string/phone_connection_automatic" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:layout_marginVertical="16dp" android:background="@drawable/bg_phone_divider" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/PhonePanelCaption" android:layout_width="0dp"
                android:layout_weight="1" android:text="@string/phone_connection_internet" />
            <TextView android:id="@+id/phoneNetworkValue" style="@style/PhonePanelCaption"
                android:layout_width="0dp" android:layout_weight="1" android:gravity="end"
                android:text="@string/phone_connection_detecting" android:textColor="@color/m3_on_surface" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView style="@style/PhonePanelCaption" android:layout_width="0dp"
                android:layout_weight="1" android:text="@string/phone_connection_cellular" />
            <TextView android:id="@+id/phoneCellularValue" style="@style/PhonePanelCaption"
                android:layout_width="0dp" android:layout_weight="1" android:gravity="end"
                android:text="@string/phone_connection_detecting" android:textColor="@color/m3_on_surface" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout style="@style/PhonePanelCard">
        <LinearLayout android:id="@+id/phoneConnectionMore" style="@style/PhonePanelDisclosure">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/PhonePanelTitle" android:text="@string/phone_connection_compatibility" />
                <TextView style="@style/PhonePanelCaption" android:layout_marginTop="4dp"
                    android:text="@string/phone_connection_compatibility_hint" />
            </LinearLayout>
            <ImageView android:id="@+id/phoneConnectionArrow" style="@style/PhonePanelArrow" android:contentDescription="@null" />
        </LinearLayout>
        <LinearLayout android:id="@+id/phoneConnectionMoreBody"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/btnBtConnectionMode" style="@style/PhonePanelCaption"
                android:minHeight="56dp" android:gravity="center_vertical"
                android:layout_marginTop="12dp" android:textColor="@color/m3_on_surface"
                android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/bg_phone_divider" />
            <TextView android:id="@+id/btnWifi" style="@style/PhonePanelCaption"
                android:minHeight="56dp" android:gravity="center_vertical" android:text="@string/phone_connection_manual"
                android:textColor="@color/m3_primary" android:background="?android:attr/selectableItemBackground"
                android:clickable="true" android:focusable="true" />
            <TextView style="@style/PhonePanelCaption" android:text="@string/phone_connection_manual_hint" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
