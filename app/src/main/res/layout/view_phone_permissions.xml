<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView style="@style/PhonePanelCaption" android:layout_marginBottom="16dp"
        android:text="@string/phone_permissions_intro" />
    <TextView android:id="@+id/permissionSummary" style="@style/PhonePanelCaption"
        android:layout_marginBottom="6dp" android:accessibilityLiveRegion="polite" />

    <LinearLayout android:id="@+id/permissionGuideGroup" style="@style/PhonePanelCard" android:padding="0dp" />
    <TextView style="@style/PhonePanelCaption" android:layout_marginTop="6dp" android:layout_marginBottom="10dp"
        android:text="@string/phone_permissions_required" />
    <LinearLayout android:id="@+id/permissionRequiredGroup" style="@style/PhonePanelCard" android:padding="0dp" />
    <TextView style="@style/PhonePanelCaption" android:layout_marginTop="6dp" android:layout_marginBottom="10dp"
        android:text="@string/phone_permissions_background" />
    <LinearLayout android:id="@+id/permissionBackgroundGroup" style="@style/PhonePanelCard" android:padding="0dp" />
    <TextView style="@style/PhonePanelCaption" android:layout_marginTop="6dp" android:layout_marginBottom="10dp"
        android:text="@string/phone_permissions_optional" />
    <LinearLayout android:id="@+id/permissionOptionalGroup" style="@style/PhonePanelCard" android:padding="0dp" />

    <TextView style="@style/PhonePanelCaption" android:layout_marginTop="6dp" android:layout_marginBottom="10dp"
        android:text="@string/phone_permissions_sleep" />
    <LinearLayout style="@style/PhonePanelCard">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                <TextView style="@style/PhonePanelTitle" android:text="@string/phone_permissions_compat" />
                <TextView style="@style/PhonePanelCaption" android:layout_marginTop="6dp"
                    android:text="@string/phone_permissions_compat_hint" />
            </LinearLayout>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/permissionCompatSwitch"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp"
                android:thumb="@drawable/sw_thumb" app:track="@drawable/sw_track"
                android:contentDescription="@string/phone_permissions_compat" />
        </LinearLayout>
        <TextView android:id="@+id/permissionSleepHelp" style="@style/PhonePanelCaption"
            android:layout_marginTop="8dp" android:minHeight="48dp" android:gravity="center_vertical"
            android:textColor="@color/m3_primary" android:text="@string/phone_permissions_sleep_help"
            android:background="?android:attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/permissionDimNow"
            style="@style/PhoneAction.Secondary" android:text="@string/phone_permissions_dim" />
    </LinearLayout>
    <TextView style="@style/PhonePanelCaption" android:layout_marginBottom="16dp"
        android:text="@string/phone_permissions_footer" />
</LinearLayout>
