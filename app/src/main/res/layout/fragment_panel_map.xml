<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="13dp"
    android:paddingTop="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="11dp"
        android:text="@string/ui_text_3cd8161216ef"
        android:textColor="@color/m3_on_var"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/mapOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/amapModeSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_amap_display_mode"
            android:textColor="@color/m3_on_surface"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/amapModeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/amapCarPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:buttonTint="@color/m3_primary"
                android:text="@string/ui_car_map_default"
                android:textColor="@color/m3_on_surface"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/amapNormalPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:buttonTint="@color/m3_primary"
                android:text="@string/ui_normal_map"
                android:textColor="@color/m3_on_surface"
                android:textSize="13sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ui_car_map_description"
            android:textColor="@color/m3_on_var"
            android:textSize="12sp" />
    </LinearLayout>
        <LinearLayout android:id="@+id/mapDisplayControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="20dp">
            <TextView android:id="@+id/mapScaleValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/m3_on_surface" android:textSize="16sp" />
            <SeekBar android:id="@+id/mapScaleSeek" android:layout_width="match_parent" android:layout_height="48dp" android:max="10" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/map_scale_hint" android:textColor="@color/m3_on_var" />
            <TextView android:id="@+id/mapHandoffState" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp" android:textColor="@color/m3_on_var" />
            <Button android:id="@+id/mapToPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/map_to_phone" />
            <Button android:id="@+id/mapToCar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/map_to_car" />
        </LinearLayout>
</LinearLayout>
</ScrollView>
