<?xml version="1.0" encoding="utf-8"?>
<!-- CarPlay 底部 dock（竖屏车机时使用）：⌂ | 运行中应用横排 | 时间/电量。
     尺寸用 dp：数值 = 设计原型 px ÷ 2.625（设计基准 1160×540@420dpi；dock 密度
     随画布短边等比下发——见 activity_dock_sidebar 注释）。
     字号不在 XML 里写死：DockActivity 按「设计 px × designScale」以 PX 设置。
     壁纸：DockActivity 往 dockWallpaper 塞「全流画布切片」（与桌面同源同路径）；
     窗口不透明（半透明窗口会透出系统合成的手机壁纸——见 activity_dock_sidebar 注释）。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/dockWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <View
        android:id="@+id/dockScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2.29dp"
        android:paddingEnd="3.81dp"
        android:paddingTop="1.52dp"
        android:paddingBottom="1.52dp">

        <ImageView
            android:id="@+id/dockHome"
            android:layout_width="38.10dp"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ui_text_1bd1b56a7c60"
            android:padding="9.90dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_dock_home" />

        <View
            android:layout_width="0.38dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2.29dp"
            android:layout_marginTop="2.29dp"
            android:layout_marginBottom="2.29dp"
            android:background="@color/glass_stroke" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="2.29dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/dockApps"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="3.81dp" android:paddingEnd="0dp">

            <TextView
                android:id="@+id/dockClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:letterSpacing="0.03"
                android:textColor="@color/m3_on_surface"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/dockSignal"
        tools:ignore="UseCompoundDrawables"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/dockSignalIcon"
                    android:layout_width="3.43dp"
                    android:layout_height="3.43dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_signal" />

                <TextView
                    android:id="@+id/dockSignalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0.76dp"
                    android:textColor="@color/m3_on_var"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/dockBatteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1.14dp"
                android:textColor="@color/m3_on_var" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
